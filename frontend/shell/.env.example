VITE_ORDER_MFE_ENTRY=https://order.example.com/remoteEntry.js
VITE_FULFILLMENT_MFE_ENTRY=https://fulfillment.example.com/remoteEntry.js
VITE_MANAGER_MFE_ENTRY=https://manager.example.com/remoteEntry.js